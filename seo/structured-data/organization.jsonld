  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "USD",
    "lowPrice": "1.00",
    "highPrice": "200.00",
    "offerCount": "3",
    "offers": [
      {
        "@type": "Offer",
        "name": "Pay-as-you-go",
        "price": "1.00",
        "priceCurrency": "USD",
