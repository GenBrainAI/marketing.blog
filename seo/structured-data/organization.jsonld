        "description": "Pay only for what you use. $1 per agent-hour."
      },
      {
        "@type": "Offer",
        "name": "Standard",
        "price": "200.00",
        "priceCurrency": "USD",
        "unitText": "per agent per month",
        "description": "Dedicated agent capacity at $200/agent/month."
      },
      {
        "@type": "Offer",
        "name": "Volume",
        "price": "160.00",
        "priceCurrency": "USD",
        "unitText": "per agent per month",
